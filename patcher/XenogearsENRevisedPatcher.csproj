<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XenogearsPW_EN_Revised_Patcher</AssemblyName>
    <Version>1.0.1</Version>
    <Product>Xenogears Perfect Works 0.11.4 - Revised English Script Patcher</Product>
    <Authors>Ricardo Sandy Aries, SS</Authors>
    <Copyright>GPL-3.0-or-later</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="patches\*.bps" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
